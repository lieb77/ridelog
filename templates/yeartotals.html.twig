<!-- Year totals -->
<h2>Yearly Totals</h2>

{% for year,months in rides %}
	<h3> {{ year }} </h3>    

	
		<table class='monthly-stats'>
		  <tr>
			<th>Total miles: </th>
			<td>{{ stats[year]['total'] }}</dtd>
		  </tr>
		  <tr>
			<th>Number of rides:</th>
			<td>{{ stats[year]['count'] }}</td>
		  </tr>
		  <tr>
			<th>Average per ride</th>
			<td>{{ stats[year]['avg'] }}</td>
		  </tr>
		  <tr>
			<th>Longest ride:</th>
			<td>{{ stats[year]['long'] }}</td>
		</tr>
		</table>
	
<table>
<thead>
<tr><th>Month</th>

{% for bike in bikes[year] %}
	<th>{{ bike }}</th>
{% endfor %}

<th>Total</th>
</tr>
    {% for month,bikesy in months %}
		<tr><td> {{ month }} </td>
			{% for bike,miles in bikesy %}				
				<td> {{ miles }} </td>
			{% endfor %}
			<td>{{ month_total[year][month] }}</td>	
		</tr>
    {% endfor %}
    <tr><td>Total</td>

    {% for bike in bikes[year] %}
    	<td>{{ bike_total[year][bike] }}</td>
    {% endfor %}
    <td>{{ year_total[year] }}</td>
    </tr>
    </table>
{% endfor %}

<h2>Grand Totals</h2>
Total Years: {{ grand['years'] }} <br />
Total Miles: {{ grand['miles'] }} <br />
Total Rides: {{ grand['rides'] }} <br />
Average:  {{ grand['avg'] }} miles per year <br />

