<!-- Yearly summary -->
<h2>Years</h2>

	<table class='ridelog-years'>
	  <tr>
		<th>Year </th>
        <th>Miles</th>
      </tr>


      {% for year,ymiles in years %}
        <tr>
            <td>{{ year }}</td>
            <td>{{ ymiles }}</td>
       </tr>

    {% endfor %}
    <tr>
      <td>Grand total</td>
      <td>{{ miles }}</td>
    </tr>

	</table>

